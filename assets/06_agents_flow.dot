digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.45, ranksep=0.7, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", color="#5f6368", fontname="Helvetica", fontsize=11, margin="0.16,0.10"];
  edge [color="#5f6368", penwidth=1.4, arrowsize=0.8];
  n0 [label="User Question", fillcolor="#e8f0fe"];
  n1 [label="LLM Agent", fillcolor="#e6f4ea"];
  n2 [label="plan_lookup", fillcolor="#fce8e6"];
  n3 [label="Tool Result", fillcolor="#fff4ce"];
  n4 [label="total_cost", fillcolor="#f3e8fd"];
  n5 [label="Tool Result", fillcolor="#e0f7fa"];
  n6 [label="Final Answer", fillcolor="#e8f5e9"];
  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4;
  n4 -> n5;
  n5 -> n6;
}