digraph G {
  rankdir=LR;
  graph [bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.7, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", margin=0.15, color="#9AA0A6"];
  edge [color="#5F6368", penwidth=1.5, arrowsize=0.8, fontname="Helvetica"];
  m [label="Models\nReasoning engine", fillcolor="#E8F0FE"];
  p [label="Prompts + Parsers\nInstructions + structure", fillcolor="#E8F0FE"];
  mem [label="Memory\nConversation state", fillcolor="#E6F4EA"];
  c [label="Chains\nFixed workflow", fillcolor="#FEF7E0"];
  rag [label="Document Q&A\nRetrieval + generation", fillcolor="#F3E8FD"];
  e [label="Evaluation\nQuality measurement", fillcolor="#FCE8E6"];
  a [label="Agents\nDynamic tool choice", fillcolor="#E0F7FA"];
  app [label="Customer Support Copilot", fillcolor="#E8F5E9", color="#34A853"];
  m -> p -> c -> rag -> e -> app;
  mem -> app;
  a -> app;
}
