digraph AgentToolFlow {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.45, ranksep=0.7, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.10"];
  edge [fontname="Helvetica", fontsize=10, color="#5f6368", penwidth=1.5, arrowsize=0.8];
  user [label="User Question\nBusiness plan + 12-month cost", fillcolor="#e6f4ea", color="#188038"];
  agent [label="LLM Agent\nDecision maker", fillcolor="#fce8e6", color="#d93025"];
  lookup [label="plan_lookup\nReturns plan facts", fillcolor="#e8f0fe", color="#1a73e8"];
  calc [label="total_cost\nCalculates 99 × 12", fillcolor="#e8f0fe", color="#1a73e8"];
  answer [label="Final Answer\nFeatures + $1,188", fillcolor="#e6f4ea", color="#188038"];
  user -> agent [label="request"];
  agent -> lookup [label="1. select tool"];
  lookup -> agent [label="price = 99\nfeatures = audit logs, API access"];
  agent -> calc [label="2. select tool"];
  calc -> agent [label="result = 1188"];
  agent -> answer [label="compose response"];
}