digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=0.45, ranksep=0.7, fontname="Helvetica"];
  node [shape=box, style="rounded,filled", color="#5f6368", fontname="Helvetica", fontsize=11, margin="0.16,0.10"];
  edge [color="#5f6368", penwidth=1.4, arrowsize=0.8];
  n0 [label="Test Cases", fillcolor="#e8f0fe"];
  n1 [label="Run RAG / App", fillcolor="#e6f4ea"];
  n2 [label="Generated Answers", fillcolor="#fce8e6"];
  n3 [label="Scoring", fillcolor="#fff4ce"];
  n4 [label="Metrics & Failure Review", fillcolor="#f3e8fd"];
  n0 -> n1;
  n1 -> n2;
  n2 -> n3;
  n3 -> n4;
}